<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show All Users</title>
    <style>
        table, th, td {
            border: 2px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>email</th>
        </tr>
        <% for(res of result) { %>
            <tr>
                <td><%= res.id %></td>
                <td><%= res.username %></td>
                <td><%= res.email %></td>
                <td>
                    <form method="GET" action="/user/<%=res.id%>/edit">
                        <button>Edit Username</button>
                    </form>
                </td>
            </tr>
        <% } %>
    </table>
</body>
</html>